{
  "manifest_version": 3,
  "name": "PocketD-D · Ponte Beyond",
  "version": "0.92.0",
  "description": "Ponte locale, verifica account e associazione opzionale del proprio accesso Beyond al Pocket via USB.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.dndbeyond.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/characters/*",
        "https://www.dndbeyond.com/profile/*/characters/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://auth-service.dndbeyond.com/*",
    "https://character-service.dndbeyond.com/*"
  ],
  "optional_permissions": [
    "cookies"
  ]
}
