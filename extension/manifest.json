{
  "manifest_version": 3,
  "name": "PocketD-D · Ponte Beyond",
  "version": "0.93.0",
  "description": "Pocket PC: collegamento USB, Beyond, look SD e backup del proprio Pocket.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.dndbeyond.com/*",
    "https://shydanrem.github.io/PocketD-D/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.dndbeyond.com/characters/*",
        "https://www.dndbeyond.com/profile/*/characters/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://shydanrem.github.io/PocketD-D/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "site-helper.js"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://auth-service.dndbeyond.com/*",
    "https://character-service.dndbeyond.com/*"
  ],
  "optional_permissions": [
    "cookies"
  ]
}
