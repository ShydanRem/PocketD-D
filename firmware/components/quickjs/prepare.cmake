# Reproducible build copy of pinned upstream. ABI fixes are declarations, not
# casts: ESP newlib defines int32_t as long while QuickJS assumes it is int.
function(pocket_prepare_quickjs ROOT DEST)
    execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE REV OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE FAILED)
    if(FAILED OR NOT REV STREQUAL "2833510432045f72915919cef680ba59e5153b16")
        message(FATAL_ERROR "Unexpected QuickJS revision; run npm run firmware:deps")
    endif()
    execute_process(COMMAND git -C "${ROOT}" diff --quiet RESULT_VARIABLE DIRTY)
    if(DIRTY)
        message(FATAL_ERROR "Pinned QuickJS sources have local changes")
    endif()
    file(READ "${ROOT}/quickjs.c" SOURCE)
    set(GUARD "#if !defined(__EMSCRIPTEN__)\n#define CONFIG_ATOMICS\n#endif")
    string(FIND "${SOURCE}" "${GUARD}" AT)
    if(AT EQUAL -1)
        message(FATAL_ERROR "Pinned QuickJS Atomics guard changed")
    endif()
    string(REPLACE "${GUARD}" "/* Pocket: no OS threads or shared memory. */" SOURCE "${SOURCE}")
    string(REPLACE "static void js_atomics_free_waiters(JSRuntime *rt);" "/* Pocket: no waiters. */" SOURCE "${SOURCE}")
    string(REPLACE "    js_atomics_free_waiters(rt);" "    /* Pocket: no waiters. */" SOURCE "${SOURCE}")
    string(REPLACE "int new_line_num, line_num, pc, v, ret, new_col_num, col_num;" "int new_line_num, line_num, pc, ret, new_col_num, col_num; int32_t v;" SOURCE "${SOURCE}")
    string(REPLACE "int radix, flags;" "int flags; int32_t radix;" SOURCE "${SOURCE}")
    string(REPLACE "int remainingElementsCount;" "int32_t remainingElementsCount;" SOURCE "${SOURCE}")
    string(REPLACE "int is_zero, index;" "int is_zero; int32_t index;" SOURCE "${SOURCE}")
    string(REPLACE "int index, is_zero;" "int is_zero; int32_t index;" SOURCE "${SOURCE}")
    string(REPLACE "res = -tm.tm_gmtoff / 60;" "\n#ifdef ESP_PLATFORM\n        res = 0; /* UTC; Date is not exposed by the converter. */\n#else\n        res = -tm.tm_gmtoff / 60;\n#endif" SOURCE "${SOURCE}")
    if(ESP_PLATFORM)
        string(REPLACE "return malloc_usable_size((void *)ptr);" "return 0; /* Pocket uses a bounded custom allocator. */" SOURCE "${SOURCE}")
    endif()
    file(GENERATE OUTPUT "${DEST}" CONTENT "${SOURCE}")
endfunction()
