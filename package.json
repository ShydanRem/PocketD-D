{
  "name": "pocket-d-d",
  "version": "0.79.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy scripts/app-server.js",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/standalone.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-isolation=none src/*.test.js",
    "beyond:probe": "node --use-env-proxy scripts/beyond-probe.js",
    "beyond:lab": "node --use-env-proxy scripts/beyond-lab.js",
    "firmware:deps": "python3 scripts/firmware-deps.py",
    "firmware:test": "bash scripts/check-firmware.sh",
    "installer:build": "npm run build && vite build --config vite.installer.config.js && python3 scripts/build-installer.py && python3 scripts/package-pc.py",
    "installer": "node scripts/installer-server.js"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "esptool-js": "0.6.0"
  }
}
